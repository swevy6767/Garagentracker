{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/remind",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/remind",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/remind-evening",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/remind-evening",
      "schedule": "0 22 * * *"
    }
  ]
}
